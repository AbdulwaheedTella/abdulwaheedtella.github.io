---
layout: default
---
{%- comment -%}
  Wrapper for every page on this site. The gem's `default` layout supplies the head, navbar and footer;
  this adds the site stylesheet (assets/css/site.css) and a scoping element. Styling hooks all start with `site-`.
{%- endcomment -%}
<link rel="stylesheet" href="{{ '/assets/css/site.css' | relative_url | bust_file_cache }}">
<div class="site">
  {% unless page.hide_header %}
    <header class="site-header">
      {% if page.eyebrow %}
        <p class="site-eyebrow">{{ page.eyebrow }}</p>
      {% endif %}
      <h1 class="site-title">{{ page.heading | default: page.title }}</h1>
      {% if page.lede %}
        <p class="site-lede">{{ page.lede }}</p>
      {% endif %}
    </header>
  {% endunless %}
  {{ content }}
</div>
