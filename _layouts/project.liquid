---
layout: site
hide_header: true
---
{%- comment -%}
  Project page: title, figure, summary (the page body), key results, methods, outputs (publications, work under review,
  code and data) and related projects. Everything except the summary comes from the front matter of the file in _projects/.
{%- endcomment -%}
{% assign pubs_data = site.data.publications.published %}
<article class="site-project">
  <nav class="site-breadcrumb" aria-label="Breadcrumb">
    <a href="{{ '/projects/' | relative_url }}">Projects</a>
    <span aria-hidden="true">/</span>
    <span>{{ page.short_title | default: page.title }}</span>
  </nav>
  <header class="site-header">
    <p class="site-eyebrow">
      {{ page.status -}}
      {%- if page.period %} &middot; {{ page.period }}{% endif %}
    </p>
    <h1 class="site-title">{{ page.title }}</h1>
  </header>

  {% if page.image %}
    <figure class="site-figure">
      <img src="{{ page.image | relative_url }}" alt="{{ page.image_alt }}" loading="eager">
      {% if page.image_credit %}
        <figcaption>
          {{ page.image_credit }}
          {% if page.image_source -%}
            <a href="{{ page.image_source }}" rel="noopener">View the paper</a>
          {%- endif %}
        </figcaption>
      {% endif %}
    </figure>
  {% endif %}

  <section aria-labelledby="summary-h" class="site-section site-section-first">
    <h2 id="summary-h" class="site-h2">Summary</h2>
    <div class="site-prose">{{ content }}</div>
  </section>

  {% if page.results %}
    <section aria-labelledby="results-h" class="site-section">
      <h2 id="results-h" class="site-h2">Key results</h2>
      <ul class="site-results">
        {% for r in page.results %}
          <li>{{ r }}</li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% if page.tech %}
    <section aria-labelledby="tech-h" class="site-section">
      <h2 id="tech-h" class="site-h2">Methods and tools</h2>
      <ul class="site-tags">
        {% for t in page.tech %}
          <li>{{ t }}</li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% assign sw = site.data.software | where: 'project', page.slug %}
  {% if page.publications or page.in_progress or sw.size > 0 %}
    <section aria-labelledby="out-h" class="site-section">
      <h2 id="out-h" class="site-h2">Outputs</h2>
      {% if page.publications %}
        <h3 class="site-h3">Publications</h3>
        <ol class="site-pubs">
          {% for pid in page.publications %}
            {% assign pub = pubs_data | where: 'id', pid | first %}
            {% if pub %}{% include site/pub-item.liquid pub=pub compact=true %}{% endif %}
          {% endfor %}
        </ol>
      {% endif %}
      {% if page.in_progress %}
        <h3 class="site-h3">Under review or in preparation</h3>
        <ul class="site-plain-list">
          {% for t in page.in_progress %}
            <li>{{ t }}</li>
          {% endfor %}
        </ul>
      {% endif %}
      {% if sw.size > 0 %}
        <h3 class="site-h3" id="code-h">Code and data</h3>
        {% include site/software-list.liquid project=page.slug %}
      {% endif %}
    </section>
  {% endif %}

  {% if page.related %}
    <section aria-labelledby="rel-h" class="site-section">
      <h2 id="rel-h" class="site-h2">Related projects</h2>
      <ul class="site-plain-list">
        {% for slug in page.related %}
          {% assign rp = site.projects | where: 'slug', slug | first %}
          {% if rp %}
            <li>
              <a href="{{ rp.url | relative_url }}">{{ rp.title }}</a>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  <p class="site-back"><a href="{{ '/projects/' | relative_url }}">&larr; All projects</a></p>
</article>
