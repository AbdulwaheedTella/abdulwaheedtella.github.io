{%- comment -%}
  A project summary card for the Projects page: picture (when the project has one), status, title, one-line summary and
  a few methods. Param: project (a document of site.projects).
{%- endcomment -%}
{% assign p = include.project %}
<article class="site-card{% if p.image %} has-image{% endif %}">
  {% if p.image %}
    <a class="site-card-image" href="{{ p.url | relative_url }}" tabindex="-1" aria-hidden="true">
      <img src="{{ p.image | relative_url }}" alt="" loading="lazy">
    </a>
  {% endif %}
  <div class="site-card-body">
    <p class="site-card-status">{{ p.status }}</p>
    <h3 class="site-card-title">
      <a href="{{ p.url | relative_url }}">{{ p.title }}</a>
    </h3>
    <p>{{ p.summary }}</p>
    {% if p.tech %}
      <ul class="site-tags" aria-label="Methods and tools">
        {% for t in p.tech limit: 5 %}
          <li>{{ t }}</li>
        {% endfor %}
      </ul>
    {% endif %}
    <p class="site-card-link">
      <a href="{{ p.url | relative_url }}">View project <span aria-hidden="true">&rarr;</span></a>
    </p>
  </div>
</article>
